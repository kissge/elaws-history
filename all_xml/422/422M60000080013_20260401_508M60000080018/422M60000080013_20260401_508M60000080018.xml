            <ItemTitle>三</ItemTitle>
            <ItemSentence>
              <Column Num="1">
                <Sentence Num="1" WritingMode="vertical">国及び地方公共団体以外の者の設置する高等学校等</Sentence>
              </Column>
              <Column Num="2">
                <Sentence Num="1" WritingMode="vertical">次に掲げる区分に応じて、それぞれ次に定める額</Sentence>
              </Column>
            </ItemSentence>
            <Subitem1 Num="1">
              <Subitem1Title>イ</Subitem1Title>
