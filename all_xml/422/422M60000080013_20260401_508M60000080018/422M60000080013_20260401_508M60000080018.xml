              <Subitem1Title>ロ</Subitem1Title>
              <Subitem1Sentence>
                <Column Num="1">
                  <Sentence Num="1" WritingMode="vertical">高等学校の通信制の課程及び専修学校通信制学科</Sentence>
                </Column>
