<?xml version="1.0" encoding="UTF-8"?>
<Law Lang="ja" Era="Reiwa" Year="08" Num="049" PromulgateMonth="09" PromulgateDay="16" LawType="MinisterialOrdinance"><LawNum>令和八年法務省令第四十九号</LawNum><LawBody><LawTitle Kana="こうぞくのみぶんをはなれたものとうのこせきのとりあつかいとうにかんするほうりつしこうきそく" Abbrev="" AbbrevKana="">皇族の身分を離れた者等の戸籍の取扱い等に関する法律施行規則</LawTitle>
    <EnactStatement>皇族の身分を離れた者等の戸籍の取扱い等に関する法律（昭和二十二年法律第百十一号）第九条第一項、第十条第一項第二号及び第十二条の規定に基づき、皇族の身分を離れた者等の戸籍の取扱い等に関する法律施行規則を次のように定める。</EnactStatement>
    <MainProvision>
      <Article Num="1">
        <ArticleCaption>（内親王又は女王と天皇及び皇族以外の男子が婚姻するときの届出事項）</ArticleCaption>
        <ArticleTitle>第一条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">皇族の身分を離れた者等の戸籍の取扱い等に関する法律（以下「法」という。）第九条第一項の法務省令で定める事項は、次に掲げるものとする。</Sentence>
          </ParagraphSentence>
          <Item Num="1">
            <ItemTitle>一</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">内親王又は女王については、内親王又は女王である旨</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="2">
            <ItemTitle>二</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">法第九条第一項に規定する男子が外国人であるときは、その国籍</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="3">
            <ItemTitle>三</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">当事者の父母の氏名及び父母との続柄並びに法第九条第一項に規定する男子が特別養子以外の養子であるときは、養親の氏名</Sentence>
            </ItemSentence>
          </Item>
        </Paragraph>
      </Article>
      <Article Num="2">
        <ArticleCaption>（内親王又は女王と天皇及び皇族以外の男子が離婚するときの届出事項）</ArticleCaption>
        <ArticleTitle>第二条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">法第十条第一項第二号の法務省令で定める事項は、次に掲げるものとする。</Sentence>
          </ParagraphSentence>
          <Item Num="1">
            <ItemTitle>一</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">協議上の離婚である旨</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="2">
            <ItemTitle>二</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">内親王又は女王については、内親王又は女王である旨</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="3">
            <ItemTitle>三</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">法第十条第一項に規定する男子が外国人であるときは、その国籍</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="4">
            <ItemTitle>四</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">当事者の父母の氏名及び父母との続柄並びに法第十条第一項に規定する男子が特別養子以外の養子であるときは、養親の氏名</Sentence>
            </ItemSentence>
          </Item>
        </Paragraph>
      </Article>
      <Article Num="3">
        <ArticleCaption>（届書の様式）</ArticleCaption>
        <ArticleTitle>第三条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">法第九条第一項の届書及び法第十条第一項の届書の様式は、それぞれ戸籍法施行規則（昭和二十二年司法省令第九十四号）附録第十二号様式及び附録第十三号様式に準ずるものとする。</Sentence>
          </ParagraphSentence>
        </Paragraph>
      </Article>
    </MainProvision>
    <SupplProvision>
      <SupplProvisionLabel>附　則</SupplProvisionLabel>
      <Paragraph Num="1">
        <ParagraphNum/>
        <ParagraphSentence>
          <Sentence Num="1" WritingMode="vertical">この省令は、皇室典範等の一部を改正する法律（令和八年法律第六十六号）の施行の日（令和八年十月二十四日）から施行する。</Sentence>
        </ParagraphSentence>
      </Paragraph>
    </SupplProvision>
  </LawBody>
</Law>
