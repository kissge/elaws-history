<?xml version="1.0" encoding="UTF-8"?>
<Law Lang="ja" Era="Reiwa" Year="08" Num="088" PromulgateMonth="10" PromulgateDay="01" LawType="MinisterialOrdinance"><LawNum>令和八年内閣府令第八十八号</LawNum><LawBody><LawTitle Kana="にほんがくじゅつかいぎほうしこうきそく" Abbrev="" AbbrevKana="">日本学術会議法施行規則</LawTitle>
    <EnactStatement>日本学術会議法（令和七年法律第七十号）第二十一条第四項（同法第二十二条第五項及び第二十四条第六項において準用する場合を含む。）、第二十六条第三項、第二十七条第三項及び第五十一条第四項の規定に基づき、日本学術会議法施行規則を次のように定める。</EnactStatement>
    <MainProvision>
      <Article Num="1">
        <ArticleCaption>（会長が選任されたときの公表事項）</ArticleCaption>
        <ArticleTitle>第一条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">日本学術会議法（令和七年法律第七十号。以下「法」という。）第二十一条第四項に規定する内閣府令で定める事項は、次に掲げる事項とする。</Sentence>
          </ParagraphSentence>
          <Item Num="1">
            <ItemTitle>一</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">会長の選任に関する方針の作成、会長の候補者の選考その他の法第二十一条第一項に規定する要件を満たす者を会長として選任するために講じた措置の内容</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="2">
            <ItemTitle>二</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">会長として選任された者が法第二十一条第一項に規定する要件を満たしていることを示す事項</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="3">
            <ItemTitle>三</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">会長の選任の過程</Sentence>
            </ItemSentence>
          </Item>
        </Paragraph>
      </Article>
      <Article Num="2">
        <ArticleCaption>（副会長が任命されたときの公表事項）</ArticleCaption>
        <ArticleTitle>第二条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">法第二十二条第五項において準用する法第二十一条第四項に規定する内閣府令で定める事項は、副会長の任命の過程とする。</Sentence>
          </ParagraphSentence>
        </Paragraph>
      </Article>
      <Article Num="3">
        <ArticleCaption>（会長又は副会長が失職したとき又は解任されたときの公表事項）</ArticleCaption>
        <ArticleTitle>第三条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">法第二十四条第六項において準用する法第二十一条第四項に規定する内閣府令で定める事項は、会長又は副会長の失職又は解任の過程とする。</Sentence>
          </ParagraphSentence>
        </Paragraph>
      </Article>
      <Article Num="4">
        <ArticleCaption>（選定助言委員及び運営助言委員になることができない者）</ArticleCaption>
        <ArticleTitle>第四条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">法第二十六条第三項及び第二十七条第三項に規定する内閣府令で定める者は、次に掲げる者とする。</Sentence>
          </ParagraphSentence>
          <Item Num="1">
            <ItemTitle>一</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">日本学術会議（以下「会議」という。）の監事</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="2">
            <ItemTitle>二</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">会議の職員</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="3">
            <ItemTitle>三</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">日本学術会議規則で定めるところにより、優れた研究又は業績がある科学者のうちから、会員と連携し、法第三十七条に規定する業務に携わる者として委嘱された者（委嘱期間が一年未満である者を除く。次条第三号において「連携会員」という。）</Sentence>
            </ItemSentence>
          </Item>
        </Paragraph>
      </Article>
      <Article Num="5">
        <ArticleCaption>（日本学術会議評価委員になることができない者）</ArticleCaption>
        <ArticleTitle>第五条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">法第五十一条第四項に規定する内閣府令で定める者は、次に掲げる者とする。</Sentence>
          </ParagraphSentence>
          <Item Num="1">
            <ItemTitle>一</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">会議の監事</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="2">
            <ItemTitle>二</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">会議の職員</Sentence>
            </ItemSentence>
          </Item>
          <Item Num="3">
            <ItemTitle>三</ItemTitle>
            <ItemSentence>
              <Sentence Num="1" WritingMode="vertical">連携会員のうち、日本学術会議規則で定めるところにより会議又は役員会に置かれる合議制の機関の長の職にある者</Sentence>
            </ItemSentence>
          </Item>
        </Paragraph>
      </Article>
    </MainProvision>
    <SupplProvision>
      <SupplProvisionLabel>附　則</SupplProvisionLabel>
      <Paragraph Num="1">
        <ParagraphNum/>
        <ParagraphSentence>
          <Sentence Num="1" WritingMode="vertical">この府令は、令和八年十月一日から施行する。</Sentence>
        </ParagraphSentence>
      </Paragraph>
    </SupplProvision>
  </LawBody>
</Law>
