        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">独立行政法人国立女性教育会館に関する省令（平成十三年文部科学省令第三十一号）は、廃止する。</Sentence>
