<?xml version="1.0" encoding="UTF-8"?>
<Law Lang="ja" Era="Reiwa" Year="08" Num="001" PromulgateMonth="11" PromulgateDay="02" LawType="MinisterialOrdinance"><LawNum>令和八年防災庁令第一号</LawNum><LawBody><LawTitle Kana="ぼうさいちょうそしききそく" Abbrev="" AbbrevKana="">防災庁組織規則</LawTitle>
    <EnactStatement>防災庁設置法（令和八年法律第六十一号）及び防災庁組織令（令和八年政令第三百四号）を実施するため、防災庁組織規則を次のように定める。</EnactStatement>
    <MainProvision>
      <Article Num="1">
        <ArticleCaption>（企画官、人事企画官、防災情報通信システム官、政策調整官、地域防災調整官、防災デジタル調整官、普及啓発・防災教育調整官、災害緊急事態対処調整官、避難支援調整官、物資支援・物資輸送調整官及び復旧復興調整官）</ArticleCaption>
        <ArticleTitle>第一条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災庁に、企画官、人事企画官、防災情報通信システム官、政策調整官、地域防災調整官、防災デジタル調整官、普及啓発・防災教育調整官、災害緊急事態対処調整官、避難支援調整官、物資支援・物資輸送調整官及び復旧復興調整官を置く。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="2">
          <ParagraphNum>２</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">企画官は、命を受けて、参事官の職務のうち重要事項についての企画及び立案並びに調整に関するもの（人事企画官及び防災情報通信システム官の所掌に属するものを除く。）を助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="3">
          <ParagraphNum>３</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">人事企画官は、命を受けて、参事官の職務のうち職員の人事に関する重要事項についての企画及び立案並びに調整に関するものを助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="4">
          <ParagraphNum>４</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災情報通信システム官は、命を受けて、参事官の職務のうち防災（災害予防、災害応急対策、災害復旧及び災害からの復興をいう。以下この条において同じ。）に関する情報通信システムに関する重要事項についての企画及び立案並びに調整に関するものを助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="5">
          <ParagraphNum>５</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">政策調整官は、命を受けて、参事官の職務のうち防災庁の所掌事務に関する総合的かつ基本的な政策に関する特定事項についての企画及び立案並びに調整に関するものを助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="6">
          <ParagraphNum>６</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">地域防災調整官は、命を受けて、参事官の職務のうち地域における防災の推進に関する特定事項についての企画及び立案並びに調整に関するもの（防災デジタル調整官、普及啓発・防災教育調整官、災害緊急事態対処調整官、避難支援調整官、物資支援・物資輸送調整官及び復旧復興調整官の所掌に属するものを除く。）を助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="7">
          <ParagraphNum>７</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災デジタル調整官は、命を受けて、参事官の職務のうちデジタル技術を活用した防災に関する特定事項についての企画及び立案並びに調整に関するもの（物資支援・物資輸送調整官の所掌に属するものを除く。）を助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="8">
          <ParagraphNum>８</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">普及啓発・防災教育調整官は、命を受けて、参事官の職務のうち防災思想の普及及び防災に関する教育に関する特定事項についての企画及び立案並びに調整に関するものを助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="9">
          <ParagraphNum>９</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">災害緊急事態対処調整官は、命を受けて、参事官の職務のうち災害応急対策に関する特定事項についての企画及び立案並びに調整に関するもの（政策調整官、防災デジタル調整官、避難支援調整官及び物資支援・物資輸送調整官の所掌に属するものを除く。）を助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="10">
          <ParagraphNum>１０</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">避難支援調整官は、命を受けて、参事官の職務のうち、災害が発生し、又は災害が発生するおそれがある場合における避難支援に関する特定事項についての企画及び立案並びに調整に関するもの（防災デジタル調整官の所掌に属するものを除く。）を助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="11">
          <ParagraphNum>１１</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">物資支援・物資輸送調整官は、命を受けて、参事官の職務のうち防災に必要な物資及び資材の備蓄、調達及び輸送に関する特定事項についての企画及び立案並びに調整に関するものを助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="12">
          <ParagraphNum>１２</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">復旧復興調整官は、命を受けて、参事官の職務のうち災害復旧及び災害からの復興に関する特定事項についての企画及び立案並びに調整に関するもの（政策調整官の所掌に属するものを除く。）を助ける。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="13">
          <ParagraphNum>１３</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">企画官の定数は併任の者を除き十人と、人事企画官、防災情報通信システム官、政策調整官、地域防災調整官、防災デジタル調整官、普及啓発・防災教育調整官、災害緊急事態対処調整官、避難支援調整官、物資支援・物資輸送調整官及び復旧復興調整官の定数はそれぞれ一人とする。</Sentence>
          </ParagraphSentence>
        </Paragraph>
      </Article>
      <Article Num="2">
        <ArticleCaption>（防災庁顧問）</ArticleCaption>
        <ArticleTitle>第二条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災庁に、防災庁顧問を置くことができる。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="2">
          <ParagraphNum>２</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災庁顧問は、防災庁の所掌事務のうち重要な施策に参画する。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="3">
          <ParagraphNum>３</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災庁顧問は、非常勤とする。</Sentence>
          </ParagraphSentence>
        </Paragraph>
      </Article>
      <Article Num="3">
        <ArticleCaption>（防災庁参与）</ArticleCaption>
        <ArticleTitle>第三条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum/>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災庁に、防災庁参与を置くことができる。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="2">
          <ParagraphNum>２</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災庁参与は、防災庁の所掌事務のうち重要な事項に参与する。</Sentence>
          </ParagraphSentence>
        </Paragraph>
        <Paragraph Num="3">
          <ParagraphNum>３</ParagraphNum>
          <ParagraphSentence>
            <Sentence Num="1" WritingMode="vertical">防災庁参与は、非常勤とする。</Sentence>
          </ParagraphSentence>
        </Paragraph>
      </Article>
    </MainProvision>
    <SupplProvision>
      <SupplProvisionLabel>附　則</SupplProvisionLabel>
      <Paragraph Num="1">
        <ParagraphNum/>
        <ParagraphSentence>
          <Sentence Num="1" WritingMode="vertical">この庁令は、公布の日から施行する。</Sentence>
        </ParagraphSentence>
      </Paragraph>
    </SupplProvision>
  </LawBody>
</Law>
